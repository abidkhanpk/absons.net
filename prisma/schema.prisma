generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @db.Uuid
  email     String
  fullName  String?  @map("full_name")
  role      String   @default("admin")
  passwordHash String @map("password_hash")
  createdAt DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")

  @@map("users")
}

model Service {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String
  icon         String?
  category     String
  isFeatured   Boolean  @default(false) @map("is_featured")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("updated_at")

  @@map("services")
}

model BlogPost {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  featuredImage String? @map("featured_image")
  authorId    String?  @db.Uuid @map("author_id")
  published   Boolean  @default(false)
  publishedAt DateTime? @db.Timestamptz(6) @map("published_at")
  createdAt   DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("updated_at")

  @@map("blog_posts")
}

model TrainingCourse {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  description   String
  duration      String?
  level         String?
  provider      String?  @default("Mobius Institute")
  featuredImage String?  @map("featured_image")
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("updated_at")

  @@map("training_courses")
}

model Testimonial {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientName     String   @map("client_name")
  clientCompany  String?  @map("client_company")
  clientPosition String?  @map("client_position")
  content        String
  rating         Int
  avatarUrl      String?  @map("avatar_url")
  isFeatured     Boolean  @default(false) @map("is_featured")
  displayOrder   Int      @default(0) @map("display_order")
  createdAt      DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("updated_at")

  @@map("testimonials")
}

model ContactInquiry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  status    String?  @default("new")
  createdAt DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")

  @@map("contact_inquiries")
}

model SiteSettings {
  id             String   @id @default("site")
  siteTitle      String   @default("ABSON Solutions") @map("site_title")
  logoUrl        String?  @map("logo_url")
  faviconUrl     String?  @map("favicon_url")
  contactEmail   String?  @map("contact_email")
  contactPhone   String?  @map("contact_phone")
  contactAddress String?  @map("contact_address")
  navAlignment   String   @default("left") @map("nav_alignment")
  navLoginText   String   @default("Login") @map("nav_login_text")
  navCtaText     String   @default("Get Started") @map("nav_cta_text")
  navCtaHref     String   @default("/contact") @map("nav_cta_href")
  navCtaEnabled  Boolean  @default(true) @map("nav_cta_enabled")
  layoutMode     String   @default("container") @map("layout_mode")
  layoutWidth    Int      @default(90) @map("layout_width")
  heroSlides     String   @default("[]") @map("hero_slides")
  heroMode       String   @default("static") @map("hero_mode")
  heroStaticIndex Int     @default(0) @map("hero_static_index")
  heroAutoplaySeconds Int  @default(6) @map("hero_autoplay_seconds")
  logoWidth      Int?     @default(40) @map("logo_width")
  logoHeight     Int?     @default(40) @map("logo_height")
  logoRadius     Int?     @default(8) @map("logo_radius")
  showLoginLink  Boolean  @default(true) @map("show_login_link")
  createdAt      DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("updated_at")

  @@map("site_settings")
}
