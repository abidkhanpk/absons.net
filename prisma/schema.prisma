generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @db.Uuid
  email     String
  fullName  String?  @map("full_name")
  role      String   @default("admin")
  passwordHash String @map("password_hash")
  createdAt DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")

  @@map("users")
}

model Service {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String
  icon         String?
  category     String
  isFeatured   Boolean  @default(false) @map("is_featured")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("updated_at")

  @@map("services")
}

model BlogPost {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  featuredImage String? @map("featured_image")
  seoTitle    String?  @map("seo_title")
  seoDescription String? @map("seo_description")
  seoKeywords String?  @map("seo_keywords")
  seoOgImage  String?  @map("seo_og_image")
  seoCanonicalUrl String? @map("seo_canonical_url")
  seoNoIndex  Boolean  @default(false) @map("seo_no_index")
  seoNoFollow Boolean  @default(false) @map("seo_no_follow")
  authorId    String?  @db.Uuid @map("author_id")
  published   Boolean  @default(false)
  approved    Boolean  @default(false)
  approvedAt  DateTime? @db.Timestamptz(6) @map("approved_at")
  publishedAt DateTime? @db.Timestamptz(6) @map("published_at")
  createdAt   DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("updated_at")

  @@map("blog_posts")
}

model Page {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  slug        String   @unique
  content     String
  seoTitle    String?  @map("seo_title")
  seoDescription String? @map("seo_description")
  seoKeywords String?  @map("seo_keywords")
  seoOgImage  String?  @map("seo_og_image")
  seoCanonicalUrl String? @map("seo_canonical_url")
  seoNoIndex  Boolean  @default(false) @map("seo_no_index")
  seoNoFollow Boolean  @default(false) @map("seo_no_follow")
  authorId    String?  @db.Uuid @map("author_id")
  published   Boolean  @default(false)
  approved    Boolean  @default(false)
  approvedAt  DateTime? @db.Timestamptz(6) @map("approved_at")
  publishedAt DateTime? @db.Timestamptz(6) @map("published_at")
  createdAt   DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("updated_at")

  @@map("pages")
}

model TrainingCourse {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  description   String
  duration      String?
  level         String?
  provider      String?  @default("Mobius Institute")
  featuredImage String?  @map("featured_image")
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("updated_at")

  @@map("training_courses")
}

model Testimonial {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientName     String   @map("client_name")
  clientCompany  String?  @map("client_company")
  clientPosition String?  @map("client_position")
  content        String
  rating         Int
  avatarUrl      String?  @map("avatar_url")
  isFeatured     Boolean  @default(false) @map("is_featured")
  displayOrder   Int      @default(0) @map("display_order")
  createdAt      DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("updated_at")

  @@map("testimonials")
}

model ContactInquiry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  status    String?  @default("new")
  createdAt DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")

  @@map("contact_inquiries")
}

model SiteSettings {
  id             String   @id @default("site")
  siteTitle      String   @default("ABSON Solutions") @map("site_title")
  logoUrl        String?  @map("logo_url")
  faviconUrl     String?  @map("favicon_url")
  contactEmail   String?  @map("contact_email")
  contactPhone   String?  @map("contact_phone")
  contactAddress String?  @map("contact_address")
  navAlignment   String   @default("left") @map("nav_alignment")
  navLoginText   String   @default("Login") @map("nav_login_text")
  navCtaText     String   @default("Get Started") @map("nav_cta_text")
  navCtaHref     String   @default("/contact") @map("nav_cta_href")
  navCtaEnabled  Boolean  @default(true) @map("nav_cta_enabled")
  navItems       Json?    @map("nav_items")
  layoutMode     String   @default("container") @map("layout_mode")
  layoutWidth    Int      @default(90) @map("layout_width")
  businessHours  String   @default("Mon - Sat, 9:00 AM - 6:00 PM") @map("business_hours")
  businessDays   String   @default("Mon - Sat") @map("business_days")
  businessHoursSchedule Json?    @map("business_hours_schedule")
  showBusinessHours Boolean @default(true) @map("show_business_hours")
  businessHoursMode String @default("table") @map("business_hours_mode")
  heroSlides     String   @default("[]") @map("hero_slides")
  heroMode       String   @default("static") @map("hero_mode")
  heroStaticIndex Int     @default(0) @map("hero_static_index")
  heroAutoplaySeconds Int  @default(6) @map("hero_autoplay_seconds")
  heroHeight     Int      @default(560) @map("hero_height")
  showServices   Boolean  @default(true) @map("show_services")
  showTraining   Boolean  @default(true) @map("show_training")
  showTestimonials Boolean @default(true) @map("show_testimonials")
  homeSections   Json?    @map("home_sections")
  logoWidth      Int?     @default(40) @map("logo_width")
  logoHeight     Int?     @default(40) @map("logo_height")
  logoRadius     Int?     @default(8) @map("logo_radius")
  showLoginLink  Boolean  @default(true) @map("show_login_link")
  editorApprovalRequired Boolean @default(true) @map("editor_approval_required")
  whyChooseTitle String?  @map("why_choose_title")
  whyChooseSubtitle String? @map("why_choose_subtitle")
  whyChooseItems Json?    @map("why_choose_items")
  whyChooseLayout String? @map("why_choose_layout")
  whyChooseMobileLayout String? @map("why_choose_mobile_layout")
  whyChooseScrollSpeed Int? @map("why_choose_scroll_speed")
  analyticsScript String? @map("analytics_script")
  headerCode   String? @map("header_code")
  footerCode   String? @map("footer_code")
  allowIndexing Boolean @default(true) @map("allow_indexing")
  seoTitleTemplate String? @map("seo_title_template")
  seoDefaultTitle String? @map("seo_default_title")
  seoDefaultDescription String? @map("seo_default_description")
  seoDefaultKeywords String? @map("seo_default_keywords")
  seoDefaultOgImage String? @map("seo_default_og_image")
  seoDefaultCanonicalBase String? @map("seo_default_canonical_base")
  staticSeo     Json?    @map("static_seo")
  createdAt      DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime @default(dbgenerated("now()")) @db.Timestamptz(6) @map("updated_at")

  @@map("site_settings")
}
